# LokBook Environment Variables Reference
# Copy relevant values to .env.local (gitignored) for local dev.
# All credentials are stored in .env.local — keep it safe, never commit.

# ---- App (Vite client-side vars) ----
# Used by src/supabaseClient.js at build time.
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://jfavkudihasswkhkouxq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon/public key>

# ---- Supabase CLI (migrations) ----
# Get SUPABASE_ACCESS_TOKEN from: https://supabase.com/dashboard/account/tokens
# Get SUPABASE_DB_PASSWORD from: Supabase Dashboard → Project Settings → Database
SUPABASE_ACCESS_TOKEN=<access token>
SUPABASE_DB_PASSWORD=<database password>

# ---- Stripe (LokPass payments) ----
# Get from: https://dashboard.stripe.com/test/apikeys
# VITE_STRIPE_PK is in src/constants.jsx — rotate if compromised
# VITE_STRIPE_PK=<stripe publishable key>

# ---- Waitlist (api/waitlist.js) ----
# Server-side only — set these in Vercel → Settings → Environment Variables,
# never in the client bundle. Same names and same two destinations as LokLingu.
# Configure EITHER destination or BOTH; with neither, the endpoint returns 503
# rather than accepting a signup nothing durable records.
#
# Destination 1 — email notice via Resend (https://resend.com):
# RESEND_API_KEY=<resend api key>
# WAITLIST_NOTIFY_EMAIL=<where "someone joined" mail goes>
# RESEND_FROM=LokBook <hello@yourdomain.com>   # optional; sandbox sender until a domain is verified
#
# Destination 2 — append a row to a Google Sheet:
# Share the sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor first.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account@project.iam.gserviceaccount.com>
# GOOGLE_PRIVATE_KEY=<private key, with literal \n line breaks>
# GOOGLE_SHEET_ID=<id from the sheet URL>
# GOOGLE_SHEET_RANGE=Sheet1!A:D                # optional; columns are when/email/phone/source

# ---- Wrangler / Cloudflare (optional) ----
# CLOUDFLARE_API_TOKEN=<token>
# CLOUDFLARE_ACCOUNT_ID=<account id>
